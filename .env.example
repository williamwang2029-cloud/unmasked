# Copy to .env (never commit .env). Leave everything commented to run rule-based (no LLM).
#LLM_PROVIDER=none          # anthropic | openai | none
#LLM_MODEL=                 # e.g. claude-haiku-5-5 for anthropic; a model name for openai
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=
#JOIN_KEY=                  # optional; random 64-char hex. If empty, keys/join.key is generated.

Gemini via the OpenAI-compatible endpoint (free with an AI Studio key):
LLM_PROVIDER=openai
LLM_MODEL=                 # a Gemini model name from AI Studio, e.g. gemini-2.0-flash
OPENAI_API_KEY=            # your AI Studio API key
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
