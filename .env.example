# Copy to .env (never commit .env)
#LLM_PROVIDER=none          # anthropic | openai | none
#LLM_MODEL=                 # e.g. claude-haiku-5-5 for anthropic; required for openai
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=
#JOIN_KEY=                  # optional; random 64-char hex. If empty, keys/join.key is generated.

LLM_PROVIDER=openai
LLM_MODEL=<a Gemini model name from AI Studio>
OPENAI_API_KEY=<your key>
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/